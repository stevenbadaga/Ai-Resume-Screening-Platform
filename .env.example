# ── Database (PostgreSQL) ──────────────────────────────
# Neon (serverless) notes:
#  - Computes scale to zero after ~5 min idle; the first connection after a
#    wake-up can take 10s+. The pg pool in src/lib/prisma.ts allows 20s.
#  - If you hit Neon's connection limit, point DATABASE_URL at the POOLED host
#    (append "-pooler" before ".aws.neon.tech") and keep the unpooled host in
#    DIRECT_URL for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/recruitai?sslmode=require"
DIRECT_URL="postgresql://user:password@localhost:5432/recruitai?sslmode=require"

# ── Auth (NextAuth) ────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-char-min-secret"

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# ── Transactional email (Gmail SMTP, Brevo, or Resend) ──
# RECOMMENDED for @gmail.com senders — authenticated Gmail SMTP:
# Instead of a third-party provider spoofing "from: you@gmail.com" (which
# Google treats as spoofing → spam), the app logs in to Google's own SMTP
# servers with a Gmail App Password. Google signs the mail properly — inbox
# delivery, no domain needed, 500 emails/day. Setup:
#   1. myaccount.google.com/security → turn ON 2-Step Verification
#   2. myaccount.google.com/apppasswords → create "RecruitAI"
#   3. Paste the 16-character password below (spaces optional)
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
#
# If GMAIL_USER + GMAIL_APP_PASSWORD are set they take priority. Otherwise:
#
# Brevo (own a domain? authenticate it — Senders & IP -> Domains -> DKIM/SPF/DMARC):
#   Verify a sender at Brevo dashboard -> Senders & IP -> Senders.
#   Free tier: 300 emails/day. Then set:
# BREVO_API_KEY="xkeysib-your-key-here"
# EMAIL_FROM="notifications@yourdomain.com"  # must match the verified sender
#
# Brevo setup (5 minutes):
#   1. Senders & IP -> Senders -> Add sender: notifications@yourdomain.com
#   2. Senders & IP -> Domains -> Add domain: yourdomain.com
#   3. Add the DKIM/SPF/DMARC records Brevo shows at your DNS provider
#      (Cloudflare: proxied-off TXT records, they verify within minutes)
#   4. Free tier: 300 emails/day
# BREVO_API_KEY="xkeysib-your-key-here"
# EMAIL_FROM="notifications@yourdomain.com"  # must match the verified sender
#
# Resend: EMAIL_FROM must be a Resend-verified domain, or use the sandbox
#   'onboarding@resend.dev' (delivers ONLY to your own Resend account email).
RESEND_API_KEY=""
# Custom sender identity, e.g. "RecruitAI <notifications@yourdomain.com>"
EMAIL_FROM=""

# ── Workspace naming ───────────────────────────────────
# Name shown for the public workspace that candidate accounts attach to
PUBLIC_WORKSPACE_NAME="Public Applications Workspace"

# ── Resume storage (Supabase Storage — CLOUD, required) ──
# Uploaded resumes are stored in a private Supabase Storage bucket so no
# candidate document persists on the host machine. Create a project at
# supabase.com, create a PRIVATE bucket named `resumes` (Storage → New bucket),
# then paste the Project URL and service_role key from Project Settings → API.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RESUME_BUCKET="resumes"
# Legacy local fallback directory — used ONLY to read/migrate pre-cloud rows;
# new uploads REQUIRE the Supabase variables above.
STORAGE_LOCAL_PATH="./uploads"

# ── Document malware scanning (spec §6.4) ──────────────
# Set to the ClamAV daemon host to enable full antivirus scanning of uploads
# (docker compose ships a `clamav` service, so use CLAMAV_HOST=clamav).
# Leave empty for signature-only scanning (EICAR, embedded executables,
# PDF active content, DOCX macros).
# CLAMAV_HOST="clamav"
# When ClamAV is configured but unreachable: fail closed (reject uploads, the
# secure default) unless this is explicitly "true".
# CLAMAV_FAIL_OPEN="false"

# ── Error tracking (Sentry, optional) ──────────────────
# Set SENTRY_DSN to enable error tracking: warn/error log events, audit
# failures, worker job failures, and client render errors are reported to
# Sentry (grouped and alertable). Leave empty to disable — tracking is a
# documented no-op and never blocks request handling.
# SENTRY_DSN="https://your-key@o0.ingest.sentry.io/0"
# SENTRY_ENVIRONMENT="staging"   # defaults to NODE_ENV when unset

# ── Redis (BullMQ queue + rate limiting) ───────────────
# REDIS_URL="redis://default:password@localhost:6379"
# Or individual fields instead of REDIS_URL:
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""

# ── Docker Compose (docker-compose.yml reads these) ────
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="change-me-strong-password"
# POSTGRES_DB="recruitai"
