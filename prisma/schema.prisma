datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                    String           @id @default(uuid())
  name                  String
  retentionPolicy       String? // JSON configuration
  branding              String? // JSON configuration
  securitySettings      String? // JSON configuration
  users                 User[]
  jobs                  JobRequisition[]
  auditEvents           AuditEvent[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  primaryOwnerId        String?
  // Domain claiming (proof of company ownership, spec §6.1 hardening):
  // a workspace's identity is its verified email domain; the display name is
  // cosmetic. pendingEmailDomain + domainClaimToken hold the DNS TXT challenge
  // awaiting verification; verifiedEmailDomain (unique) is the proven claim.
  verifiedEmailDomain   String?          @unique
  pendingEmailDomain    String?
  domainClaimToken      String?
  domainClaimVerifiedAt DateTime?
}

model User {
  notifications           Notification[]
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String?
  passwordHash            String?
  accessStatus            String                   @default("ACTIVE") // ACTIVE, SUSPENDED, INVITED
  emailVerifiedAt         DateTime? // NULL = email not yet verified (spec §6.1: only valid emails)
  departmentRestrictions  String[] // Array of allowed departments
  organizationId          String
  organization            Organization             @relation(fields: [organizationId], references: [id])
  roles                   Role[]
  ownedJobs               JobRequisition[]         @relation("JobOwner")
  applicationsAssigned    Application[]            @relation("AssignedRecruiter")
  decisionsMade           RecruitmentDecision[]    @relation("DecisionActor")
  interviewsParticipated  InterviewParticipant[]
  sentCommunications      Communication[]          @relation("Sender")
  auditEvents             AuditEvent[]             @relation("Actor")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String
  users       User[]
  permissions String[]
}

model JobRequisition {
  id             String          @id @default(uuid())
  title          String
  department     String?
  location       String?
  employmentType String?
  description    String
  status         String          @default("DRAFT") // DRAFT, OPEN, CLOSED
  ownerId        String
  owner          User            @relation("JobOwner", fields: [ownerId], references: [id])
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  rubrics        Rubric[]
  applications   Application[]
  communications Communication[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status]) // org-scoped job listing (§9 performance)
}

model Rubric {
  id            String         @id @default(uuid())
  version       Int            @default(1)
  status        String         @default("DRAFT") // DRAFT, REVIEW, APPROVED, ARCHIVED
  changeReason  String?
  jobId         String
  job           JobRequisition @relation(fields: [jobId], references: [id])
  criteria      Criterion[]
  screeningRuns ScreeningRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Criterion {
  id            String                @id @default(uuid())
  category      String
  description   String
  isRequired    Boolean               @default(false)
  weight        Int                   @default(1)
  threshold     String? // e.g. minimum years or minimum level
  evidenceRules String? // e.g. what counts as evidence
  rubricId      String
  rubric        Rubric                @relation(fields: [rubricId], references: [id])
  assessments   CriterionAssessment[]
}

model Candidate {
  id                   String           @id @default(uuid())
  firstName            String
  lastName             String
  email                String
  consentGiven         Boolean          @default(false)
  // Spec §6.11: the privacy-notice version the candidate accepted, when they
  // accepted it, and the consent choices captured at application time.
  consentNoticeVersion String?
  consentGivenAt       DateTime?
  consentChoices       String? // JSON — permitted consent choices
  source               String? // E.g., LinkedIn, Career Page
  tags                 String[]
  applications         Application[]
  privacyRequests      PrivacyRequest[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([email]) // duplicate detection lookups (§6.3)
}

model Application {
  id                  String                @id @default(uuid())
  candidateId         String
  candidate           Candidate             @relation(fields: [candidateId], references: [id])
  jobId               String
  job                 JobRequisition        @relation(fields: [jobId], references: [id])
  assignedRecruiterId String?
  assignedRecruiter   User?                 @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id])
  stage               String                @default("NEW")
  status              String                @default("ACTIVE")
  notes               String? // JSON or text
  decisionHistory     String? // JSON tracking previous/new stages
  resumeDocument      ResumeDocument?
  parsedProfile       ParsedProfile?
  screeningRuns       ScreeningRun[]
  decisions           RecruitmentDecision[]
  interviews          Interview[]
  communications      Communication[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([jobId])
  @@index([candidateId])
  @@index([stage]) // dashboard funnel + pipeline filters (§9 performance)
}

model ResumeDocument {
  id               String         @id @default(uuid())
  applicationId    String         @unique
  application      Application    @relation(fields: [applicationId], references: [id])
  fileReference    String // Path or URL to S3
  processingStatus String         @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, NEEDS_REVIEW
  extractedText    String?
  version          Int            @default(1)
  checksum         String?
  safeMetadata     String? // JSON
  accessHistory    String? // JSON
  screeningRuns    ScreeningRun[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([processingStatus]) // processing health views (§6.12)
}

model ParsedProfile {
  id                String      @id @default(uuid())
  applicationId     String      @unique
  application       Application @relation(fields: [applicationId], references: [id])
  skills            String? // JSON
  employment        String? // JSON
  education         String? // JSON
  certifications    String? // JSON
  languages         String? // JSON
  projects          String? // JSON
  manualCorrections String? // JSON linked to source evidence
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model ScreeningRun {
  id               String                @id @default(uuid())
  applicationId    String
  application      Application           @relation(fields: [applicationId], references: [id])
  rubricId         String
  rubric           Rubric                @relation(fields: [rubricId], references: [id])
  resumeId         String
  resume           ResumeDocument        @relation(fields: [resumeId], references: [id])
  rubricVersion    Int? // Spec §6.5/§7: rubric version used, for reproducibility
  resumeVersion    Int? // Spec §6.5/§7: resume document version used
  aiVersion        String
  configuration    String? // JSON — full scoring config snapshot for reproducibility
  status           String                @default("PROCESSING")
  totalResult      Float?
  effectiveResult  Float?
  errorInformation String?
  assessments      CriterionAssessment[]
  decisions        RecruitmentDecision[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([applicationId]) // screening history per application (§6.3)
}

model CriterionAssessment {
  id                 String       @id @default(uuid())
  screeningRunId     String
  screeningRun       ScreeningRun @relation(fields: [screeningRunId], references: [id])
  criterionId        String
  criterion          Criterion    @relation(fields: [criterionId], references: [id])
  result             String // e.g. MATCH, PARTIAL, MISSING
  effectiveResult    String?
  supportingEvidence String?
  sourceLocation     String? // e.g. bounding box or text snippet
  uncertainty        Boolean      @default(false)
  scoreContribution  Float?
  reviewerCorrection String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([screeningRunId])
}

model RecruitmentDecision {
  id             String        @id @default(uuid())
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id])
  screeningRunId String?
  screeningRun   ScreeningRun? @relation(fields: [screeningRunId], references: [id])
  actorId        String
  actor          User          @relation("DecisionActor", fields: [actorId], references: [id])
  humanAction    String
  decisionType   String // SHORTLIST, REJECT, ADVANCE
  reason         String
  previousStage  String
  newStage       String
  createdAt      DateTime      @default(now())
}

model Interview {
  id             String                 @id @default(uuid())
  applicationId  String
  application    Application            @relation(fields: [applicationId], references: [id])
  schedule       DateTime?
  timezone       String?
  status         String                 @default("SCHEDULED")
  meetingDetails String?
  participants   InterviewParticipant[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([applicationId])
}

model InterviewParticipant {
  id                 String    @id @default(uuid())
  interviewId        String
  interview          Interview @relation(fields: [interviewId], references: [id])
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  structuredFeedback String? // JSON
  comments           String?
  recommendation     String? // e.g. HIRE, NO_HIRE
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Communication {
  id             String          @id @default(uuid())
  applicationId  String?
  application    Application?    @relation(fields: [applicationId], references: [id])
  jobId          String?
  job            JobRequisition? @relation(fields: [jobId], references: [id])
  senderId       String?
  sender         User?           @relation("Sender", fields: [senderId], references: [id])
  recipient      String // Email address
  template       String
  contentVersion String
  deliveryState  String          @default("PENDING") // PENDING, SENT, FAILED
  /// Populated by sendRecordedEmail() on delivery failure (spec §6.9);
  /// added in migrations/20260911000000_add_email_failure_info
  failureInfo    String?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([deliveryState]) // failed-notification follow-up (§6.12)
  @@index([applicationId])
}

model PrivacyRequest {
  id                  String    @id @default(uuid())
  candidateId         String
  candidate           Candidate @relation(fields: [candidateId], references: [id])
  noticeVersion       String
  consentRecord       String? // JSON
  candidateRequest    String? // e.g. DELETE, EXPORT
  decision            String?
  completionEvidence  String?
  anonymizationAction String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AuditEvent {
  id               String        @id @default(uuid())
  actorId          String?
  actor            User?         @relation("Actor", fields: [actorId], references: [id])
  action           String
  affectedRecordId String?
  previousValues   String? // JSON
  newValues        String? // JSON
  timestamp        DateTime      @default(now())
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  requestContext   String? // JSON
  // Tamper-evident hash chain (spec §6.1): hash commits to this event's
  // content plus the previous event's hash; verifyAuditChain() detects any
  // silent edit or deletion of historical events.
  previousHash     String?
  hash             String?

  @@index([organizationId, timestamp]) // org-scoped audit search (§6.12)
  @@index([action])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the emailed token — the plain token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the emailed token — the plain token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("JOB_POSTED")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
